#!/usr/bin/env bash
# Remove repos that are no longer in the declarative config.
#
# Compares per-repo state files in the state directory against
# the current repo names JSON list. Any state file not in the
# list triggers removal of the repo directory, tmux session,
# and state file.
#
# Usage: repo-sync-cleanup <current-repos.json> <state-dir>

set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "Usage: repo-sync-cleanup <current-repos.json> <state-dir>" >&2
  exit 1
fi

CURRENT="$1"
STATE_DIR="$2"

if [[ ! -d "$STATE_DIR" ]]; then
  exit 0
fi

for state_file in "$STATE_DIR"/*.json; do
  [[ -f "$state_file" ]] || continue
  name=$(basename "$state_file" .json)
  if ! jaq -e --arg k "$name" 'index($k) != null' "$CURRENT" > /dev/null; then
    repo_path=$(jaq -r '.path' "$state_file")
    session=$(jaq -r '.session // empty' "$state_file")
    echo "repo-sync: removing $name ($repo_path)"
    rm -rf "$repo_path"
    if [[ -n "$session" ]]; then
      tmux kill-session -t "$session" 2>/dev/null || true
    fi
    rm "$state_file"
  fi
done
