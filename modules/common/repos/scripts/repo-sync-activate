#!/usr/bin/env bash
# Activate a single declaratively managed repository.
#
# Handles: clone, adopt, path/url/branch/session changes,
# .env generation, git excludes, and state tracking.
#
# File creation (.envrc, .workmux.yaml, declared files) is handled
# by home.file — this script only does git operations and state management.
#
# Usage: repo-sync-activate <repo-config.json> <repos-base> <owner>

set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "Usage: repo-sync-activate <repo-config.json> <repos-base> <owner>" >&2
  exit 1
fi

CONFIG="$1"
REPOS_BASE="$2"
OWNER="$3"
STATE_DIR="${HOME}/.local/state/repo-sync"

name=$(jq -r '.name' "$CONFIG")
url=$(jq -r '.url' "$CONFIG")
path=$(jq -r '.path' "$CONFIG")
branch=$(jq -r '.branch' "$CONFIG")
session=$(jq -r '.tmuxSession' "$CONFIG")
dest="$REPOS_BASE/$path"

mkdir -p "$STATE_DIR"

# Read old state
OLD_STATE='{}'
STATE_FILE="$STATE_DIR/$name.json"
if [[ -f "$STATE_FILE" ]]; then
  OLD_STATE=$(cat "$STATE_FILE")
fi

# Move directory if path changed
old_path=$(echo "$OLD_STATE" | jq -r '.path // empty')
if [[ -n "$old_path" ]] && [[ "$old_path" != "$dest" ]] && [[ -d "$old_path" ]]; then
  echo "repo-sync: moving $name from $old_path to $dest"
  mv "$old_path" "$dest"
fi

if [[ -d "$dest" ]] && [[ ! -d "$dest/.bare" ]]; then
  echo "ERROR: $dest exists but is not a bare-clone repo" >&2
  exit 1
elif [[ -d "$dest/.bare" ]]; then
  GIT_DIR="$dest/.bare" git remote set-url origin "$url"
  GIT_DIR="$dest/.bare" git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  # Remove old worktree if default branch changed
  old_branch=$(echo "$OLD_STATE" | jq -r '.branch // empty')
  if [[ -n "$old_branch" ]] && [[ "$old_branch" != "$branch" ]] && [[ -d "$dest/$old_branch" ]]; then
    if [[ -n $(GIT_DIR="$dest/.bare" GIT_WORK_TREE="$dest/$old_branch" git status --porcelain) ]]; then
      echo "ERROR: cannot change default branch for $name — worktree $old_branch has uncommitted changes" >&2
      exit 1
    fi
    GIT_DIR="$dest/.bare" git worktree remove "$dest/$old_branch"
  fi
  if [[ ! -d "$dest/$branch" ]]; then
    GIT_DIR="$dest/.bare" git worktree add "$dest/$branch" "$branch"
  fi
else
  mkdir -p "$dest"
  git clone --bare "$url" "$dest/.bare"
  GIT_DIR="$dest/.bare" git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  GIT_DIR="$dest/.bare" git worktree add "$dest/$branch" "$branch"
fi

# Rename tmux session if the name changed
old_session=$(echo "$OLD_STATE" | jq -r '.session // empty')
if [[ -n "$old_session" ]] && [[ "$old_session" != "$session" ]]; then
  tmux rename-session -t "$old_session" "$session" 2>/dev/null || true
fi

# Ensure tmux session exists
if ! tmux has-session -t "$session" 2>/dev/null; then
  tmux new-session -d -s "$session" -c "$dest" 2>/dev/null || true
fi

# Generate .env from key-value pairs (values may be agenix secret paths)
env_keys=$(jq -r '.env // {} | keys[]' "$CONFIG")
if [[ -n "$env_keys" ]]; then
  env_file="$dest/$branch/.env"
  install -m 0600 -o "$OWNER" /dev/null "$env_file"
  while IFS= read -r env_key; do
    env_val=$(jq -r --arg ek "$env_key" '.env[$ek]' "$CONFIG")
    if [[ -f "$env_val" ]]; then
      env_val=$(cat "$env_val")
    fi
    echo "${env_key}=${env_val}" >> "$env_file"
  done <<< "$env_keys"
fi

# Add managed files to git exclude
exclude_file="$dest/.bare/info/exclude"
for entry in .workmux.yaml .env $(jq -r '.files // {} | keys[]' "$CONFIG"); do
  if ! grep -qxF "$entry" "$exclude_file" 2>/dev/null; then
    echo "$entry" >> "$exclude_file"
  fi
done

# Write new state
jq -n --arg p "$dest" --arg s "$session" --arg b "$branch" '{path: $p, session: $s, branch: $b}' > "$STATE_FILE"
