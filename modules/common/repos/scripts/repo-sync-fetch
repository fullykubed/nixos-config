#!/usr/bin/env bash
# Fetch a single declaratively managed repository.
#
# Usage: repo-sync-fetch <bare-dir>

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: repo-sync-fetch <bare-dir>" >&2
  exit 1
fi

BARE_DIR="$1"

if [[ ! -d "$BARE_DIR" ]]; then
  echo "warning: $BARE_DIR does not exist, skipping" >&2
  exit 0
fi

GIT_DIR="$BARE_DIR" git fetch --all
