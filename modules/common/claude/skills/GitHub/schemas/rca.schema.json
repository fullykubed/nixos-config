{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["root_cause", "evidence", "suggested_fixes", "confidence"],
  "additionalProperties": false,
  "properties": {
    "root_cause": {
      "type": "string",
      "minLength": 1,
      "description": "Concise summary of the root cause (1-3 sentences)"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Specific evidence supporting the root cause"
    },
    "contributing_factors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Related conditions that contribute to the issue"
    },
    "ruled_out": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Paths investigated but ruled out as the cause"
    },
    "suggested_fixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "changes", "tradeoffs", "confidence"],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Summary of the fix approach"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["location", "description"],
              "additionalProperties": false,
              "properties": {
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "description": "GitHub permalink to the file/line to modify"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What to change at this location"
                }
              }
            },
            "description": "File changes required for this fix"
          },
          "tradeoffs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Trade-offs, risks, or side effects of this fix"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence that this fix resolves the issue"
          }
        }
      },
      "description": "Suggested fixes for the root cause, each with its own file changes, trade-offs, and confidence"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Confidence level in the root cause determination"
    }
  }
}
