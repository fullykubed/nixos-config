#!/usr/bin/env bash
# Outputs the absolute path of the default branch's worktree.
# Relies on git-default-branch to determine the branch name.

set -euo pipefail

default_branch=$(git-default-branch)

git worktree list --porcelain \
  | grep -B2 "^branch refs/heads/${default_branch}$" \
  | grep "^worktree " \
  | cut -d' ' -f2
