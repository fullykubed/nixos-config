#!/usr/bin/env bash

set -euo pipefail

if [[ -n "${1:-}" ]]; then
    target="$1"
else
    target="$(git remote show "$(git remote)" | awk '/HEAD branch/ {print $NF}')"
fi

echo "Fetching origin..."
git fetch origin

# Update local branch - method depends on whether it's checked out
worktree_path=$(git worktree list --porcelain | grep -B2 "^branch refs/heads/$target\$" | grep "^worktree " | cut -d' ' -f2)
if [[ -n "$worktree_path" ]]; then
    # Branch is checked out - pull from within that worktree
    git -C "$worktree_path" pull --ff-only 2>/dev/null || true
else
    # Branch is not checked out - update ref directly
    git fetch origin "$target:$target" 2>/dev/null || true
fi

echo "Rebasing onto $target..."
if git rebase "$target"; then
    echo "Rebase complete."
else
    echo "Conflicts detected, restarting rebase with Claude Code..."
    git rebase --abort
    claude -p --dangerously-skip-permissions --no-session-persistence --model sonnet "/rebase $target"
    echo "Rebase complete."
fi
