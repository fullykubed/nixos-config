#!/usr/bin/env bash

set -euo pipefail

# Constants
MAX_DIFF_SIZE=50000

# Temp files (MSG_FILE uses git's standard COMMIT_EDITMSG for filetype detection)
git_dir=$(git rev-parse --git-dir)
MSG_FILE="$git_dir/COMMIT_EDITMSG"
CLAUDE_RESPONSE_FILE=$(mktemp)
HOOK_OUTPUT_FILE=$(mktemp)
FIXER_OUTPUT_FILE=$(mktemp)

# Cleanup temp files on exit (don't delete COMMIT_EDITMSG - git expects it to persist)
cleanup() {
    rm -f "$CLAUDE_RESPONSE_FILE" "$HOOK_OUTPUT_FILE" "$FIXER_OUTPUT_FILE"
}
trap cleanup EXIT

# Parse optional motivation argument
motivation="${1:-}"

# Use nvr when inside nvim to open commit editor in parent instance
if [[ -n "${NVIM:-}" ]]; then
    export GIT_EDITOR="nvr --remote-tab-wait-silent"
fi

# Check for staged changes
if git diff --cached --quiet; then
    echo "Error: No staged changes to commit" >&2
    exit 1
fi

# Get the diff (with size handling)
diff=$(git diff --cached)
diff_size=${#diff}

if [[ $diff_size -gt $MAX_DIFF_SIZE ]]; then
    # Use stat summary for large diffs
    diff_summary=$(git diff --cached --stat)
    diff="[Diff too large - showing summary only]

$diff_summary

[Truncated diff - first $MAX_DIFF_SIZE chars]
${diff:0:$MAX_DIFF_SIZE}..."
fi

# Find and load PRD context files from repo root
prd_context=""
repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -n "$repo_root" && -d "$repo_root/.claude/prds" ]]; then
    while IFS= read -r -d '' prd_file; do
        prd_content=$(<"$prd_file")
        prd_context+="
--- PRD Context: $prd_file ---
$prd_content
"
    done < <(find "$repo_root/.claude/prds" -name "PRD.md" -print0 2>/dev/null)
fi

# JSON schema for validation
json_schema='{
  "type": "object",
  "required": ["type", "description"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["feat", "fix", "chore", "docs", "refactor", "test", "style", "perf", "build", "ci"]
    },
    "scope": {
      "type": "string",
      "maxLength": 20
    },
    "description": {
      "type": "string",
      "maxLength": 60
    },
    "body": {
      "type": "string",
      "minLength": 10,
      "pattern": "^[^\\u0060](?:(?!.{81})[^\\n]*(?:\\n(?!.{81})[^\\n]*)*)?[^\\u0060]$"
    }
  },
  "additionalProperties": false
}'

# System prompt with instructions
system_prompt="Generate a conventional commit message for the provided git diff.

Audience: Other engineers who will review this commit and care about why the changes were made, not just what changed.

Requirements:
- Use conventional commit format
- Keep the description concise (under 60 characters)
- Add a body if the changes are complex to explain the \"why\"
- Keep each line in the body under 80 characters
- Focus on the \"why\" not just the \"what\"

Output Format:
Return ONLY valid JSON matching this schema (no markdown, no code blocks):
{
  \"type\": \"feat|fix|chore|docs|refactor|test|style|perf|build|ci\",
  \"scope\": \"optional scope\",
  \"description\": \"short description without type prefix\",
  \"body\": \"optional longer explanation\"
}

Examples:

{\"type\": \"feat\", \"scope\": \"auth\", \"description\": \"add OAuth2 login support\", \"body\": \"Integrate Google OAuth2 for user authentication to reduce friction during signup and improve security by eliminating password storage.\"}

{\"type\": \"fix\", \"scope\": \"api\", \"description\": \"prevent race condition in cache invalidation\", \"body\": \"Multiple concurrent requests could read stale data when the cache was being refreshed. Add mutex lock around cache updates.\"}"

# User prompt with diff, optional PRD context, and optional motivation
user_prompt="${motivation:+Motivation: $motivation

}${prd_context:+Project Context:
$prd_context

}Diff:
$diff"

# Run git hooks and Claude in parallel for speed
git_common_dir=$(git rev-parse --git-common-dir)
hook_script="$git_common_dir/hooks/pre-commit"
hook_exit=0
fixer_pid=""

# Check if pre-commit hook exists
if [[ -x "$hook_script" ]]; then
    echo "Running git hooks and generating commit message in parallel..."

    # Start Claude in background
    (claude --system-prompt "$system_prompt" --output-format json --json-schema "$json_schema" --model sonnet --fallback-model haiku --no-session-persistence --tools "" --strict-mcp-config -p "$user_prompt" > "$CLAUDE_RESPONSE_FILE" 2>&1) &
    claude_pid=$!

    # Run pre-commit hook directly (works with any framework), capture output
    "$hook_script" > "$HOOK_OUTPUT_FILE" 2>&1 && hook_exit=0 || hook_exit=$?

    # If hooks failed, immediately start Fixer to fix (parallel with Claude and user editing)
    if [[ $hook_exit -ne 0 ]]; then
        hook_output=$(cat "$HOOK_OUTPUT_FILE")
        echo ""
        echo "Git hook failure detected. Starting Claude Fixer in background..."

        claude --model opus --fallback-model sonnet --dangerously-skip-permissions --verbose -p "The git commit failed due to git hook failures. Here is the output:

$hook_output

IMPORTANT RULES:
1. Only edit files necessary to fix the hook failures
2. Do not change any functionality - only fix formatting/linting issues
3. After fixing, verify by running: $hook_script
4. Stage your changes with: git add <file>
5. Do NOT create a commit - the user will do that" > "$FIXER_OUTPUT_FILE" 2>&1 &
        fixer_pid=$!
    fi

    # Wait for Claude to finish
    wait $claude_pid && claude_exit=0 || claude_exit=$?
    claude_response=$(cat "$CLAUDE_RESPONSE_FILE")
else
    echo "Generating commit message..."

    # No hooks, just run Claude
    if ! claude_response=$(claude --system-prompt "$system_prompt" --output-format json --json-schema "$json_schema" --model sonnet --fallback-model haiku --no-session-persistence --tools "" --strict-mcp-config -p "$user_prompt"); then
        claude_exit=1
    else
        claude_exit=0
    fi
fi

if [[ $claude_exit -ne 0 ]]; then
    echo "Error: Failed to generate commit message" >&2
    echo "Claude response: $claude_response" >&2
    exit 1
fi

# Validate JSON and extract fields
if ! echo "$claude_response" | jq empty 2>/dev/null; then
    echo "Error: Claude returned invalid JSON" >&2
    echo "Response: $claude_response" >&2
    exit 1
fi

# Extract from structured_output field (Claude wraps result in metadata)
commit_type=$(echo "$claude_response" | jq -r '.structured_output.type')
commit_scope=$(echo "$claude_response" | jq -r '.structured_output.scope // empty')
commit_desc=$(echo "$claude_response" | jq -r '.structured_output.description')
commit_body=$(echo "$claude_response" | jq -r '.structured_output.body // empty')

# Construct the commit message
if [[ -n "$commit_scope" ]]; then
    commit_msg="${commit_type}(${commit_scope}): ${commit_desc}"
else
    commit_msg="${commit_type}: ${commit_desc}"
fi

if [[ -n "$commit_body" ]]; then
    commit_msg="${commit_msg}

${commit_body}"
fi

# Write message to temp file
echo "$commit_msg" >"$MSG_FILE"

# Open editor for user to review/edit the message (runs in parallel with Fixer if needed)
${GIT_EDITOR:-${EDITOR:-nvim}} "$MSG_FILE"

# Wait for Fixer to finish if it was started
if [[ -n "$fixer_pid" ]]; then
    echo "Waiting for Claude Fixer to finish..."
    wait $fixer_pid && fixer_exit=0 || fixer_exit=$?

    # Display Fixer's output
    echo ""
    echo "=== Fixer Output ==="
    cat "$FIXER_OUTPUT_FILE"
    echo "===================="
    echo ""

    if [[ $fixer_exit -ne 0 ]]; then
        echo "Error: Claude Fixer failed to fix hook issues" >&2
        exit 1
    fi

    # Fixer made fixes - run hooks to verify its work
    git commit -F "$MSG_FILE"
else
    # Hooks already passed during parallel run - skip them
    git commit --no-verify -F "$MSG_FILE"
fi
